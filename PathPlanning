<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0f766e">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>主世界铁路 · 路径规划</title>
<style>
:root{
  --bg:#eef1f5; --card:#fff; --fg:#141922; --muted:#6b7280; --line:#e3e8ef;
  --accent:#0f766e; --accent-fg:#fff; --chip:#f3f5f9; --shadow:0 1px 3px rgba(16,24,40,.08),0 8px 24px rgba(16,24,40,.06);
}
@media (prefers-color-scheme:dark){
  :root{--bg:#0e1218;--card:#171d26;--fg:#e8edf5;--muted:#9aa3b2;--line:#252d3a;--chip:#1f2733;
        --shadow:0 1px 3px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35);}
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{
  background:var(--bg);color:var(--fg);font:16px/1.5 -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei","Noto Sans CJK SC",system-ui,sans-serif;
  padding:env(safe-area-inset-top) env(safe-area-inset-right) calc(env(safe-area-inset-bottom) + 24px) env(safe-area-inset-left);
}
.wrap{max-width:680px;margin:0 auto;padding:16px}
header{padding:18px 2px 10px}
h1{margin:0;font-size:21px;letter-spacing:.3px}
header p{margin:4px 0 0;color:var(--muted);font-size:13px}
.card{background:var(--card);border-radius:16px;box-shadow:var(--shadow);padding:14px;margin-bottom:14px}
.field{display:flex;align-items:center;gap:10px;width:100%;min-height:54px;padding:10px 12px;
  background:var(--chip);border:0;border-radius:12px;color:var(--fg);font-size:17px;text-align:left;cursor:pointer}
.field:active{opacity:.7}
.field .k{color:var(--muted);font-size:13px;min-width:34px}
.field .v{font-weight:600;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.field .v.empty{font-weight:400;color:var(--muted)}
.row{display:flex;gap:8px;align-items:stretch;margin-top:8px}
.row .field{flex:1}
.swap{width:52px;flex:0 0 52px;border:0;border-radius:12px;background:var(--chip);color:var(--fg);font-size:20px;cursor:pointer}
.seg{display:flex;background:var(--chip);border-radius:12px;padding:4px;margin-top:12px}
.seg button{flex:1;border:0;background:transparent;color:var(--muted);font-size:15px;padding:9px 4px;border-radius:9px;cursor:pointer;font-weight:600}
.seg button.on{background:var(--card);color:var(--fg);box-shadow:0 1px 2px rgba(0,0,0,.12)}
.opts{display:flex;align-items:center;gap:8px;margin-top:12px;color:var(--muted);font-size:14px}
.opts input{width:20px;height:20px}
.primary{width:100%;margin-top:14px;min-height:52px;border:0;border-radius:13px;background:var(--accent);color:var(--accent-fg);
  font-size:17px;font-weight:700;cursor:pointer}
.primary:active{opacity:.85}
.sum{display:flex;gap:14px;align-items:baseline;flex-wrap:wrap;margin-bottom:4px}
.sum b{font-size:22px}
.sum span{color:var(--muted);font-size:14px}
.leg{border-top:1px solid var(--line);padding:12px 0 4px}
.leg:first-of-type{border-top:0}
.leghead{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.dot{width:12px;height:12px;border-radius:50%;flex:0 0 12px;box-shadow:0 0 0 2px rgba(127,127,127,.18)}
.leghead b{font-size:16px}
.leghead em{font-style:normal;color:var(--muted);font-size:13px}
.stops{margin:8px 0 0;color:var(--fg);font-size:15px;line-height:1.9;word-break:break-word}
.stops i{color:var(--muted);font-style:normal;padding:0 3px}
.stops .x{color:var(--accent);font-weight:700}
.xfer{display:flex;align-items:center;gap:8px;margin:10px 0 -2px;color:var(--accent);font-size:14px;font-weight:600}
.xfer .bar{flex:1;height:1px;background:var(--line)}
.note{color:var(--muted);font-size:13px;margin-top:10px}
.err{color:#b42318;font-size:15px}
h2{font-size:15px;margin:0 0 10px;color:var(--muted);font-weight:600;letter-spacing:.4px}
.linelist{display:flex;flex-direction:column;gap:10px;font-size:14px}
.li{display:flex;align-items:flex-start;gap:8px;padding:9px 0;border-top:1px solid var(--line)}
.li:first-child{border-top:0}
.li .nm{font-weight:600;margin-bottom:2px}
.li .ep{color:var(--muted);font-size:12.5px}
.seq{margin-top:4px;font-size:13px;line-height:1.95;color:var(--fg);word-break:break-word}
.seq .st.dead{color:#b42318}
.seq .ar{color:var(--muted);font-style:normal;padding:0 3px}
.seq .ar.dead{color:#b42318}
table{width:100%;border-collapse:collapse;font-size:14px}
td,th{text-align:left;padding:7px 6px;border-top:1px solid var(--line);vertical-align:top}
th{color:var(--muted);font-weight:600;font-size:13px}
td.n{white-space:nowrap;font-weight:600}
details summary{cursor:pointer;color:var(--muted);font-size:14px;font-weight:600;padding:4px 0}
.sheet{position:fixed;inset:0;z-index:50;display:flex;align-items:flex-end}
.sheet[hidden]{display:none}
.sheet .bg{position:absolute;inset:0;background:rgba(10,14,20,.45)}
.sheet .panel{position:relative;width:100%;max-height:86vh;background:var(--card);border-radius:18px 18px 0 0;
  display:flex;flex-direction:column;padding-bottom:env(safe-area-inset-bottom)}
.sheet .head{display:flex;gap:8px;padding:12px;border-bottom:1px solid var(--line)}
.sheet .head input{flex:1;min-height:44px;border:0;border-radius:11px;background:var(--chip);color:var(--fg);
  padding:0 12px;font-size:17px}
.sheet .head button{border:0;background:transparent;color:var(--accent);font-size:16px;font-weight:600;cursor:pointer}
.sheet .list{overflow:auto;-webkit-overflow-scrolling:touch;padding:4px 0 12px}
.it{display:flex;align-items:center;gap:10px;padding:13px 16px;border-bottom:1px solid var(--line);cursor:pointer}
.it:active{background:var(--chip)}
.it .zh{font-size:17px}
.it .en{color:var(--muted);font-size:12.5px}
.it .dots{display:flex;gap:3px;margin-left:auto}
.it .dots span{width:9px;height:9px;border-radius:50%;display:block}
footer{color:var(--muted);font-size:12.5px;text-align:center;padding:6px 0 20px;line-height:1.8}
.bad{font-style:normal;color:#b42318;font-size:12px}
.mapwrap{position:relative;border-radius:12px;overflow:hidden;background:var(--chip);border:1px solid var(--line)}
.mapwrap img{display:block;width:100%;height:auto;cursor:zoom-in}
.maptip{color:var(--muted);font-size:13px;margin-top:8px}
.viewer{position:fixed;inset:0;z-index:60;background:#0b0e13;display:flex;flex-direction:column}
.viewer[hidden]{display:none}
.viewer .bar{display:flex;gap:8px;align-items:center;padding:10px 12px;
  padding-top:calc(10px + env(safe-area-inset-top));background:#111722;color:#e8edf5;font-size:15px}
.viewer .bar b{flex:1;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.viewer .bar button{border:0;background:#22304a;color:#e8edf5;border-radius:9px;padding:10px 13px;font-size:14px;cursor:pointer}
.stage{flex:1;overflow:hidden;touch-action:none;position:relative}
.stage img{position:absolute;left:0;top:0;transform-origin:0 0;max-width:none}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>主世界铁路 · 路径规划</h1>
    <p>Overworld Railway System · 2026-08-11 · <span id="stat"></span></p>
  </header>

  <section class="card">
    <div class="row">
      <button class="field" id="fromBtn"><span class="k">起点</span><span class="v empty" id="fromV">请选择车站</span></button>
      <button class="swap" id="swapBtn" title="交换">⇅</button>
    </div>
    <div class="row">
      <button class="field" id="toBtn"><span class="k">终点</span><span class="v empty" id="toV">请选择车站</span></button>
    </div>
    <div class="seg" id="modeSeg">
      <button data-mode="time" class="on">最少时间</button>
      <button data-mode="transfers">最少换乘</button>
      <button data-mode="stops">最少站数</button>
    </div>
    <label class="opts"><input type="checkbox" id="preferExpress"> 倾向走高速线路（1/2/4/7/15号线，乘坐要求较高）</label>
    <label class="opts"><input type="checkbox" id="unopened"> 把未开通的虚线区间也算进来</label>
    <button class="primary" id="goBtn">计算路线</button>
  </section>

  <section id="result"></section>

  <section class="card">
    <h2>线路图</h2>
    <div class="seg" id="mapSeg" style="margin:0 0 10px">
      <button data-map="overworld" class="on">主世界铁路</button>
      <button data-map="nether">地狱上层铁路</button>
    </div>
    <div class="mapwrap"><img id="mapImg" src="data:image/webp;base64," data-overworld="data:image/webp;base64," data-nether="data:image/webp;base64," alt="线路图"></div>
    <div class="maptip">点一下看大图：支持双指缩放、拖动、双击放大/还原。</div>
  </section>

  <section class="card">
    <details>
      <summary>线路一览（<span id="lineCount"></span>）</summary>
      <div class="linelist" id="lineList" style="margin-top:8px"></div>
    </details>
  </section>

  <section class="card">
    <details>
      <summary>不可用站点（<span id="closedCount"></span>）</summary>
      <div id="closedList" style="margin-top:8px"></div>
    </details>
  </section>

  <footer>
    用时估算：每站 2 分钟 · 每次换乘 4 分钟<br>
    数据来自线路图逐站核对；市中心少数相邻关系为按图推断
  </footer>
</div>

<div class="sheet" id="sheet" hidden>
  <div class="bg" data-close></div>
  <div class="panel">
    <div class="head">
      <input id="search" placeholder="搜索站名 / 英文" autocomplete="off">
      <button data-close>取消</button>
    </div>
    <div class="list" id="list"></div>
  </div>
</div>

<div class="viewer" id="viewer" hidden>
  <div class="bar">
    <b>主世界铁路线路图</b>
    <button id="zoomOut">－</button>
    <button id="zoomIn">＋</button>
    <button id="mapClose">关闭</button>
  </div>
  <div class="stage" id="stage"></div>
</div>

