  // 主世界优先：先禁用地狱换乘搜索；只有主世界走不通时才启用（与命令行版一致）
  function plan(origin, dest, mode, includeUnopened, avoid, preferExpress) {
    let r = planOnce(origin, dest, mode, includeUnopened, avoid, preferExpress, true);
    if (r && !r.error) return r;
    r = planOnce(origin, dest, mode, includeUnopened, avoid, preferExpress, false);
    if (r && !r.error) r.nether = true;
    return r;
  }

  return { LINES: LINES, EN: EN, PY: DATA.py || {}, ALL: ALL, BY_NO: BY_NO, UNAVAILABLE: UNAVAILABLE,
           resolve: resolve, plan: plan, MODE_NAME: MODE_NAME, COLORS: DATA.colors,
           lineClass: lineClass, lineShort: lineShort, EXPRESS: EXPRESS, HOLLOW: HOLLOW, PEN: PEN,
           // 已开通线路号（4号线全线未开通，故不在此列）
           openLines: Object.keys(buildGraph(false, {}, "time", false).seqs).map(Number) };
})();
// <<<ENGINE

/* ---------------------------------------------------------------- UI ---- */
(function () {
  const $ = s => document.querySelector(s);
  const state = { from: null, to: null, mode: "time", unopened: false, preferExpress: false };

  const stationsWithLines = {};
  RR.LINES.forEach(l => l.segments.forEach(seg => seg.forEach(s => {
    (stationsWithLines[s] = stationsWithLines[s] || []).push(l.no);
  })));
  const allStations = Object.keys(stationsWithLines).sort((a, b) => a.localeCompare(b, "zh"));

  $("#stat").textContent = RR.LINES.filter(l => !l.virtual && !l.nether && !l.excluded).length +
    " 条主世界线路 + " + RR.LINES.filter(l => l.nether).length + " 条地狱线路 · " +
    allStations.length + " 座车站";

  // ---- 选择器 ----
  let picking = null;
  function openSheet(which) {
    picking = which;
    $("#sheet").hidden = false;
    $("#search").value = "";
    renderList("");
    setTimeout(() => $("#search").focus(), 60);
  }
  function closeSheet() { $("#sheet").hidden = true; picking = null; }
  function renderList(q) {
    q = (q || "").trim().toLowerCase();
    const py = RR.PY || {};
    const list = allStations.filter(s => {
      if (!q) return true;
      if (s.toLowerCase().indexOf(q) >= 0) return true;
      if ((RR.EN[s] || "").toLowerCase().indexOf(q) >= 0) return true;
      const p = py[s] || [];                 // 拼音搜索：全拼或首字母
      return (p[0] || "").indexOf(q) >= 0 || (p[1] || "").indexOf(q) >= 0;
    });
    const html = list.map(s => {
      const dots = (stationsWithLines[s] || []).map(no =>
        '<span style="background:' + (RR.COLORS[no] || "#999") + '"></span>').join("");
      const closed = RR.UNAVAILABLE.some(u => u.station === s);
      return '<div class="it" data-s="' + s + '"><div><div class="zh">' + s +
             (closed ? ' <em style="font-style:normal;color:#b42318;font-size:12px">未开通</em>' : "") +
             '</div><div class="en">' + (RR.EN[s] || "") + '</div></div><div class="dots">' + dots + '</div></div>';
    }).join("");
    $("#list").innerHTML = html || '<div class="it"><div class="en">没有匹配的车站</div></div>';
  }
  $("#list").addEventListener("click", e => {
    const it = e.target.closest(".it"); if (!it || !it.dataset.s) return;
    state[picking] = it.dataset.s;
    paint(); closeSheet();
    if (state.from && state.to) run();
  });
  $("#search").addEventListener("input", e => renderList(e.target.value));
  $("#fromBtn").addEventListener("click", () => openSheet("from"));
  $("#toBtn").addEventListener("click", () => openSheet("to"));
  document.querySelectorAll("[data-close]").forEach(el => el.addEventListener("click", closeSheet));
  $("#swapBtn").addEventListener("click", () => {
    const t = state.from; state.from = state.to; state.to = t; paint();
    if (state.from && state.to) run();
  });
  $("#modeSeg").addEventListener("click", e => {
    const b = e.target.closest("button[data-mode]"); if (!b) return;
    state.mode = b.dataset.mode;
    document.querySelectorAll("#modeSeg button").forEach(x => x.classList.toggle("on", x === b));
    if (state.from && state.to) run();
  });
  $("#unopened").addEventListener("change", e => { state.unopened = e.target.checked; if (state.from && state.to) run(); });
  $("#preferExpress").addEventListener("change", e => { state.preferExpress = e.target.checked; if (state.from && state.to) run(); });
  $("#goBtn").addEventListener("click", run);

  function paint() {
    [["from", "#fromV"], ["to", "#toV"]].forEach(([k, sel]) => {
      const el = $(sel);
      el.textContent = state[k] ? state[k] + "（" + (RR.EN[state[k]] || "") + "）" : "请选择车站";
      el.classList.toggle("empty", !state[k]);
    });
  }

  function lineColor(no) { return RR.COLORS[no] || "#888"; }

  function run() {
    const box = $("#result");
    if (!state.from || !state.to) { box.innerHTML = '<div class="card err">请先选择起点和终点。</div>'; return; }
    const r = RR.plan(state.from, state.to, state.mode, state.unopened, {}, state.preferExpress);
    if (r.error) { box.innerHTML = '<div class="card err">' + r.error + '</div>'; return; }
    let html = '<div class="card"><div class="sum"><b>' + r.stops + ' 站</b>' +
      '<span>' + r.transfers + ' 次换乘</span><span>约 ' + Math.round(r.minutes) + ' 分钟</span>' +
      '<span>' + RR.MODE_NAME[r.mode] + '</span></div>';
    if (state.unopened) html += '<div class="note">已把未开通的虚线区间一并计入</div>';
    if (r.nether) html += '<div class="note">主世界线路无法直接到达，本方案需经地狱铁路换乘</div>';
    r.legs.forEach((leg, i) => {
      const l = RR.BY_NO[leg.no];
      html += '<div class="leg">';
      if (i > 0) html += '<div class="xfer"><span>换乘 ' + (leg.short || (leg.no + '号线')) + '</span><span class="bar"></span></div>';
      html += '<div class="leghead">' +
        '<span class="dot" style="background:' + lineColor(leg.no) + '"></span>' +
        '<b>' + (leg.short || (leg.no + '号线')) + ((l && !l.virtual) ? ' ' + l.name : '') + '</b><em>开往 ' + leg.dir + '</em></div>';
      const chips = leg.stations.map((s, k) => {
        const cls = (k === 0 && i > 0) ? ' class="x"' : '';
        return '<span' + cls + '>' + s + '</span>';
      }).join('<i>→</i>');
      html += '<div class="stops">' + chips + '</div>';
      html += '<div class="note">本段 ' + (leg.stations.length - 1) + ' 站</div></div>';
    });
    html += '</div>';
    box.innerHTML = html;
    box.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  // ---- 线路一览 / 不可用站点 ----
  $("#lineCount").textContent = RR.LINES.filter(l => !l.virtual && !l.nether).length +
    " 条 + 地狱 " + RR.LINES.filter(l => l.nether).length + " 条";
  const isClosedLink = (l, a, b) => (l.closed_links || []).some(p =>
    (p[0] === a && p[1] === b) || (p[0] === b && p[1] === a));
  let netherHeader = false;
  $("#lineList").innerHTML = RR.LINES.map(l => {
    let head = "";
    if (l.nether && !netherHeader) {
      netherHeader = true;
      head = '<div class="li" style="border-top:0"><b style="color:var(--accent)">── 地狱上层铁路（与主世界同名站即为换乘点） ──</b></div>';
    }
    const isOpen = RR.openLines.indexOf(l.no) >= 0;
    const un = (l.unopened || []);
    const deadSet = l.unopened_stations || [];
    const cs = l.closed_stations || [];
    const chains = l.segments.map(seg => {
      let h = "";
      seg.forEach((s, i) => {
        h += '<span class="st' + (deadSet.indexOf(s) >= 0 ? ' dead' : '') + '">' + s + '</span>';
        if (i + 1 < seg.length) {
          const linkClosed = isClosedLink(l, s, seg[i + 1]) &&
            (deadSet.indexOf(s) >= 0 || deadSet.indexOf(seg[i + 1]) >= 0);
          h += '<i class="ar' + (linkClosed ? ' dead' : '') + '">→</i>';
        }
      });
      return '<div class="seq">' + h + '</div>';
    }).join("");
    let tag = "";
    const cls = RR.lineClass ? RR.lineClass(l.no) : "普通";
    const clsTag = (cls === "普通") ? "" :
      ' <em class="bad" style="color:var(--accent)">〔' + cls + '〕</em>';
    if (l.pending) tag = ' <em class="bad" style="color:#b45309">' +
      (l.segments.length ? '待补全（尚未转录完整，暂不参与算路）' : '尚未转录（暂不参与算路）') + '</em>';
    else if (l.excluded) tag = ' <em class="bad" style="color:var(--accent)">已移出主世界线网</em>';
    else if (l.virtual) tag = ' <em class="bad" style="color:var(--accent)">虚拟换乘</em>';
    else if (!isOpen) tag = ' <em class="bad">全线未开通</em>';
    else {
      const parts = [];
      if (un.length) parts.push("未开通区间：" + un.join("；"));
      if (cs.length) parts.push("暂缓开通站：" + cs.join("、"));
      if (parts.length) tag = ' <em class="bad">' + parts.join(" · ") + '</em>';
    }
    return head + '<div class="li"><span class="dot" style="background:' + lineColor(l.no) + '"></span>' +
      '<div style="flex:1"><div class="nm">' + (l.short || (l.no + '号线')) + (l.virtual ? '' : ' ' + l.name) + clsTag + tag + '</div>' +
      chains + '</div></div>';
  }).join("");

  $("#closedCount").textContent = RR.UNAVAILABLE.length + " 个";
  $("#closedList").innerHTML = '<table><tr><th>站名</th><th>线路</th><th>类型</th><th>依据</th></tr>' +
    RR.UNAVAILABLE.map(u => '<tr><td class="n">' + u.station + '</td><td>' + u.lines.map(n => RR.lineShort(n)).join("、") +
      '</td><td>' + u.kind + '</td><td>' + u.note + '</td></tr>').join("") + '</table>';

  paint();

  // ---- 地图切换：主世界 / 地狱上层铁路 ----
  (function () {
    const seg = document.querySelector("#mapSeg"), img = $("#mapImg");
    if (!seg || !img) return;
    seg.addEventListener("click", e => {
      const b = e.target.closest("button[data-map]"); if (!b) return;
      document.querySelectorAll("#mapSeg button").forEach(x => x.classList.toggle("on", x === b));
      img.src = (b.dataset.map === "nether") ? img.dataset.nether : img.dataset.overworld;
    });
  })();

  // ---- 地图查看器：双指缩放 / 拖动 / 双击 ----
  (function () {
    const img = $("#mapImg"), viewer = $("#viewer"), stage = $("#stage"), home = img.parentNode;
    if (!img || !img.getAttribute("src")) return;
    let s = 1, tx = 0, ty = 0, baseW = 0, baseH = 0;
    const pts = new Map();
    let lastDist = 0, moved = false, lastTap = 0;

    const apply = () => { img.style.transform = "translate(" + tx + "px," + ty + "px) scale(" + s + ")"; };
    function clamp() {
      const r = stage.getBoundingClientRect(), w = baseW * s, h = baseH * s;
      tx = (w <= r.width) ? (r.width - w) / 2 : Math.min(0, Math.max(r.width - w, tx));
      ty = (h <= r.height) ? (r.height - h) / 2 : Math.min(0, Math.max(r.height - h, ty));
    }
    function reset() {
      const r = stage.getBoundingClientRect();
      const fit = Math.min(r.width / img.naturalWidth, r.height / img.naturalHeight);
      baseW = img.naturalWidth * fit; baseH = img.naturalHeight * fit;
      img.style.width = baseW + "px"; img.style.height = baseH + "px";
      s = 1; tx = 0; ty = 0; clamp(); apply();
    }
    function zoomAt(cx, cy, factor) {
      const ns = Math.min(8, Math.max(1, s * factor)), k = ns / s;
      tx = cx - (cx - tx) * k; ty = cy - (cy - ty) * k; s = ns; clamp(); apply();
    }
    function open() {
      viewer.hidden = false;
      stage.appendChild(img);
      requestAnimationFrame(reset);
    }
    function close() {
      viewer.hidden = true;
      home.appendChild(img);
      img.removeAttribute("style");
    }
    img.addEventListener("click", open);
    $("#mapClose").addEventListener("click", close);
    $("#zoomIn").addEventListener("click", () => { const r = stage.getBoundingClientRect(); zoomAt(r.width / 2, r.height / 2, 1.5); });
    $("#zoomOut").addEventListener("click", () => { const r = stage.getBoundingClientRect(); zoomAt(r.width / 2, r.height / 2, 1 / 1.5); });

    stage.addEventListener("pointerdown", e => {
      try { stage.setPointerCapture(e.pointerId); } catch (err) {}
      pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      moved = false;
      if (pts.size === 2) {
        const a = [...pts.values()];
        lastDist = Math.hypot(a[0].x - a[1].x, a[0].y - a[1].y);
      }
    });
    stage.addEventListener("pointermove", e => {
      if (!pts.has(e.pointerId)) return;
      const prev = pts.get(e.pointerId);
      const dx = e.clientX - prev.x, dy = e.clientY - prev.y;
      if (Math.abs(dx) + Math.abs(dy) > 2) moved = true;
      pts.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pts.size === 1) { tx += dx; ty += dy; clamp(); apply(); }
      else if (pts.size === 2) {
        const a = [...pts.values()];
        const d = Math.hypot(a[0].x - a[1].x, a[0].y - a[1].y);
        const r = stage.getBoundingClientRect();
        zoomAt((a[0].x + a[1].x) / 2 - r.left, (a[0].y + a[1].y) / 2 - r.top,
               lastDist > 0 ? d / lastDist : 1);
        lastDist = d;
      }
    });
    function up(e) {
      pts.delete(e.pointerId);
      if (pts.size < 2) lastDist = 0;
      const now = Date.now();
      if (!moved && now - lastTap < 320) {
        const r = stage.getBoundingClientRect();
        zoomAt(e.clientX - r.left, e.clientY - r.top, s > 1.6 ? 1 / s : 2.2);
        lastTap = 0;
      } else lastTap = now;
    }
    stage.addEventListener("pointerup", up);
    stage.addEventListener("pointercancel", e => { pts.delete(e.pointerId); lastDist = 0; });
    stage.addEventListener("wheel", e => {
      e.preventDefault();
      const r = stage.getBoundingClientRect();
      zoomAt(e.clientX - r.left, e.clientY - r.top, e.deltaY < 0 ? 1.15 : 1 / 1.15);
    }, { passive: false });
    window.addEventListener("resize", () => { if (!viewer.hidden) reset(); });
    window.addEventListener("keydown", e => { if (e.key === "Escape" && !viewer.hidden) close(); });
  })();

  (function () {
    const q = new URLSearchParams(location.search);
    const f = q.get("from") || q.get("f"), t = q.get("to") || q.get("t");
    if (f) { const r = RR.resolve(f); if (r) state.from = r; }
    if (t) { const r = RR.resolve(t); if (r) state.to = r; }
    const m = q.get("mode");
    if (m && RR.MODE_NAME[m]) {
      state.mode = m;
      document.querySelectorAll("#modeSeg button").forEach(x => x.classList.toggle("on", x.dataset.mode === m));
    }
    if (q.get("u") === "1" || q.get("unopened") === "1") {
      state.unopened = true; $("#unopened").checked = true;
    }
    if (q.get("express") === "1" || q.get("e") === "1") {
      state.preferExpress = true; $("#preferExpress").checked = true;
    }
    if (state.from || state.to) paint();
    if (state.from && state.to) run();
  })();
})();
</script>
